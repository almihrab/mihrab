{
  "$schema": "vscode://schemas/color-theme",
  "name": "محراب الداكنة عالية التباين",
  "type": "hcDark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#FFFFFF",
    "contrastBorder": "#6FE7D2",
    "contrastActiveBorder": "#FFD479",
    "focusBorder": "#FFD479",
    "foreground": "#FFFFFF",
    "editorLineNumber.foreground": "#9FB3BA",
    "editorLineNumber.activeForeground": "#FFFFFF",
    "editor.lineHighlightBorder": "#6FE7D2",
    "editor.selectionBackground": "#00463E",
    "editor.selectionForeground": "#FFFFFF",
    "editorCursor.foreground": "#FFD479",
    "editorWhitespace.foreground": "#4A5A5F",
    "editorIndentGuide.background1": "#4A5A5F",
    "editorIndentGuide.activeBackground1": "#6FE7D2",
    "editorBracketMatch.background": "#000000",
    "editorBracketMatch.border": "#FFD479",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#9FB3BA",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#9FB3BA",
    "activityBar.activeBorder": "#FFD479",
    "activityBarBadge.background": "#FFD479",
    "activityBarBadge.foreground": "#000000",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#FFFFFF",
    "sideBarSectionHeader.background": "#0D0D0D",
    "sideBarTitle.foreground": "#FFFFFF",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#6FE7D2",
    "statusBar.noFolderBackground": "#000000",
    "statusBar.debuggingBackground": "#000000",
    "tab.activeBackground": "#000000",
    "tab.inactiveBackground": "#000000",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveForeground": "#9FB3BA",
    "tab.activeBorderTop": "#FFD479",
    "tab.border": "#6FE7D2",
    "editorGroupHeader.tabsBackground": "#000000",
    "panel.background": "#000000",
    "panel.border": "#6FE7D2",
    "panelTitle.activeForeground": "#FFFFFF",
    "terminal.background": "#000000",
    "terminal.foreground": "#FFFFFF",
    "input.background": "#000000",
    "input.foreground": "#FFFFFF",
    "input.border": "#6FE7D2",
    "dropdown.background": "#000000",
    "dropdown.border": "#6FE7D2",
    "list.activeSelectionBackground": "#00463E",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.hoverBackground": "#0D0D0D",
    "list.highlightForeground": "#FFD479",
    "button.background": "#000000",
    "button.foreground": "#FFFFFF",
    "button.border": "#6FE7D2",
    "button.hoverBackground": "#0D0D0D",
    "badge.background": "#FFD479",
    "badge.foreground": "#000000",
    "progressBar.background": "#FFD479",
    "textLink.foreground": "#7FC4EC",
    "textLink.activeForeground": "#FFD479",
    "scrollbarSlider.background": "#4A5A5F",
    "scrollbarSlider.hoverBackground": "#9FB3BA",
    "editorWidget.background": "#000000",
    "editorWidget.border": "#6FE7D2",
    "editorSuggestWidget.background": "#000000",
    "editorSuggestWidget.border": "#6FE7D2",
    "editorSuggestWidget.selectedBackground": "#00463E",
    "editorHoverWidget.background": "#000000",
    "editorHoverWidget.border": "#6FE7D2",
    "peekViewEditor.background": "#000000"
  },
  "tokenColors": [
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#9FB3BA"
      }
    },
    {
      "scope": "comment",
      "settings": {
        "foreground": "#9FB3BA"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#FFAE85"
      }
    },
    {
      "scope": "constant.regexp",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "constant.character",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": [
        "entity.name.tag.css",
        "entity.name.tag.less"
      ],
      "settings": {
        "foreground": "#FFAE85"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "source.css entity.other.attribute-name.class",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.parent-selector.css",
        "entity.other.attribute-name.parent.less",
        "source.css entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element.css",
        "source.css.less entity.other.attribute-name.id",
        "entity.other.attribute-name.scss"
      ],
      "settings": {
        "foreground": "#FFAE85"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#FFA599"
      }
    },
    {
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7FC4EC"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#FFAE85"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "name": "brackets of XML/HTML tags",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#9FB3BA"
      }
    },
    {
      "scope": "meta.preprocessor",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "meta.preprocessor.string",
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "scope": "meta.preprocessor.numeric",
      "settings": {
        "foreground": "#FFAE85"
      }
    },
    {
      "scope": "meta.structure.dictionary.key.python",
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "storage.modifier",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "scope": "string.tag",
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "scope": "string.value",
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": [
        "support.type.vendored.property-name",
        "support.type.property-name",
        "source.css variable",
        "source.coffee.embedded"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "keyword.control",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#FFAE85"
      }
    },
    {
      "scope": "support.function.git-rebase",
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": "constant.sha.git-rebase",
      "settings": {
        "foreground": "#FFAE85"
      }
    },
    {
      "name": "coloring of the Java import and package identifiers",
      "scope": [
        "storage.modifier.import.java",
        "variable.language.wildcard.java",
        "storage.modifier.package.java"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "coloring of the TS this",
      "scope": "variable.language.this",
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member"
      ],
      "settings": {
        "foreground": "#6FE7D2"
      }
    },
    {
      "name": "Types declaration and references",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.name.class",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy"
      ],
      "settings": {
        "foreground": "#7FC4EC"
      }
    },
    {
      "name": "Types declaration and references, TS grammar specific",
      "scope": [
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json",
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "foreground": "#7FC4EC"
      }
    },
    {
      "name": "Control flow / Special keywords",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "source.cpp keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "name": "Variable and parameter name",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Object keys, TS grammar specific",
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "CSS property value",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "name": "HC Search Editor context line override",
      "scope": "meta.resultLinePrefix.contextLinePrefix.search",
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "name": "تعليق",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#9FB3BA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "كلمة مفتاحيّة",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#FFD479"
      }
    },
    {
      "name": "نصّ",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#B8E986"
      }
    },
    {
      "name": "رقم",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFAE85"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#6FE7D2",
    "method": "#6FE7D2",
    "class": "#7FC4EC",
    "struct": "#7FC4EC",
    "enum": "#7FC4EC",
    "interface": "#7FC4EC",
    "type": "#7FC4EC",
    "typeParameter": "#7FC4EC",
    "namespace": "#7FC4EC",
    "variable": "#FFFFFF",
    "parameter": "#FFFFFF",
    "property": "#FFFFFF",
    "enumMember": "#FFAE85",
    "keyword": "#FFD479",
    "number": "#FFAE85",
    "string": "#B8E986",
    "comment": {
      "foreground": "#9FB3BA",
      "fontStyle": "italic"
    }
  }
}
