# خدمةُ محرابِ الويب — مربوطةٌ بالحلقة المحلّيّة، وnginx وحدَه يواجه العالم.
#
# ⚠️ غيرُ مُجرَّبةٍ على الخادم بعد. الخياراتُ مقروءةٌ من `--help` الخادمِ نفسِه
# (بناء 1.126.05942) لا مفترَضة.
#
#   sudo useradd --system --home-dir /var/lib/mihrab --shell /bin/bash mihrab
#   sudo cp deploy/systemd/mihrab-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mihrab-web

[Unit]
Description=محراب — محرِّرٌ عربيُّ الاتّجاه في المتصفّح
Documentation=https://mihrab.dev
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

# بلا رمزٍ لا خدمة: الشرطُ أرخصُ من اكتشافِ أنّ المحرِّرَ عملَ مفتوحًا. وحين يفشل،
# تُعلَّم الوحدةُ `condition failed` ولا تدخل حلقةَ إعادة تشغيل.
ConditionPathExists=/etc/mihrab/token

[Service]
Type=simple
User=mihrab
Group=mihrab
WorkingDirectory=/opt/mihrab/web
UMask=0027

# ── البيتُ صريحٌ لا مستنتَج ──────────────────────────────────────────────────
# ‏`ProtectHome=true` يجعل `/home` و`/root` **فارغةً** داخل الخدمة. وأثرُ ذلك ليس
# تجميليًّا: الطرفيّةُ المدمجة تفتح في مجلّدٍ غيرِ موجود، و`git` لا يجد `~/.gitconfig`
# فيفشل **كلُّ commit**، ولا `~/.ssh` فيستحيل `git push`. وأخبثُ منه أنّ `HOME` قد
# يكون غيرَ مضبوطٍ أصلًا لو أُنشئ المستخدمُ بـ`--no-create-home` ⇒ سلوكٌ عشوائيٌّ في Node.
# فيُوضَع بيتٌ حقيقيٌّ داخل منطقة الحالة، ويُستعمل `tmpfs` بدل `true`.
Environment=HOME=/var/lib/mihrab
Environment=SHELL=/bin/bash
Environment=XDG_CONFIG_HOME=/var/lib/mihrab/.config
Environment=XDG_CACHE_HOME=/var/lib/mihrab/.cache

# ‏**رمزُ الاتّصال ليس اختياريًّا هنا.** الخادمُ يفتح طرفيّةً ونظامَ ملفّاتٍ لمن يصله؛
# و`--without-connection-token` على منفذٍ يبلغه العالمُ = تنفيذُ شيفرةٍ عن بُعدٍ لأيّ زائر.
#   sudo install -d -m 750 -o mihrab -g mihrab /etc/mihrab
#   openssl rand -hex 32 | sudo tee /etc/mihrab/token >/dev/null
#   sudo chown mihrab:mihrab /etc/mihrab/token && sudo chmod 600 /etc/mihrab/token
#
# ‏`--accept-server-license-terms` **مقيسٌ موجودٌ** في `--help` بناءِ محراب (شُكَّ في
# وجوده أثناء المراجعة؛ القياسُ حسم). إن غاب يومًا فالخدمةُ تفشل عند الإقلاع.
ExecStart=/opt/mihrab/web/node /opt/mihrab/web/out/server-main.js \
    --host 127.0.0.1 \
    --port 14007 \
    --connection-token-file /etc/mihrab/token \
    --server-data-dir /var/lib/mihrab \
    --telemetry-level off \
    --accept-server-license-terms

# ‏`on-failure` لا يغطّي الخروجَ النظيف بـ0 ⇒ 502 حتّى تدخّلٍ يدويّ.
Restart=always
RestartSec=5s
# ‏StartLimit* موضعُهما [Unit] أعلاه — نُقلا إليه منذ systemd 229، وفي [Service]
# يسجّل systemd «Unknown key name» ويتجاهلهما. والأثرُ ليس تجميليًّا: مع
# `Restart=always` تصير خدمةٌ تسقط عند الإقلاع (رمزٌ مفقود، منفذٌ مشغول) حلقةَ
# إعادةِ تشغيلٍ أبديّةً كلَّ خمسِ ثوانٍ بلا حالةِ `failed` ⇒ بلا تنبيهٍ لأحد.

# ── تقييدٌ متناسبٌ مع خدمةٍ تُنفِّذ شيفرةَ المستخدم عمدًا ──────────────────────
NoNewPrivileges=true          # ⇐ يعطّل `sudo` في الطرفيّة المدمجة. مقصودٌ، لا عطب.
PrivateTmp=true               # ⇐ `/tmp` معزول: وكيلُ SSH وأدواتٌ تتوقّع مشاركتَه لن تراه.
ProtectHome=tmpfs
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
StateDirectory=mihrab         # ينشئ /var/lib/mihrab بالملكيّة الصحيحة تلقائيًّا
ReadWritePaths=/var/lib/mihrab /opt/mihrab/data

# ملاحظةُ صدق: مع `ProtectSystem=full` يبقى `/var` و`/opt` قابلَين للكتابة أصلًا،
# فـ`ReadWritePaths` أعلاه **بلا أثرٍ فعليّ** — وُضع للتوثيق ولانتقالٍ لاحقٍ إلى
# `strict`. ومعناه أنّ الخدمةَ تستطيع الكتابةَ في `/opt/mihrab/web` نفسِه، أي تعديلَ
# الشيفرةِ التي تنفّذها. التشديدُ الحقيقيُّ (`ProtectSystem=strict` + `ReadOnlyPaths`)
# تغييرٌ سلوكيٌّ كبيرٌ على الطرفيّة — يُجرَّب في مرحلةٍ ثانية، لا في أوّل تشغيل.

# ⛔ ممنوعاتٌ مقصودة — كلٌّ منها يكسر الخدمة، ولا تُضَف «تقسيةً»:
#   MemoryDenyWriteExecute=true       ⇐ يقتل مُصرِّفَ V8 الآنيّ. Node لا يقلع أصلًا.
#   PrivateDevices=true               ⇐ يحجب /dev/ptmx ⇒ لا طرفيّةَ زائفة ⇒ لا طرفيّة.
#                                        فخٌّ شائع: يبدو بريئًا ويقتل الطرفيّةَ صامتًا.
#   RestrictNamespaces=true           ⇐ يمنع docker/podman من الطرفيّة المدمجة.
#   SystemCallFilter=@system-service  ⇐ غيرُ مؤكَّدٍ مع طرفيّةٍ تُنفّذ أيَّ ثنائيّ. لا بلا قياس.

# مقابسُ WebSocket كثيرةٌ لكلّ جلسة (‏مضيفُ الامتدادات · الطرفيّة · المهامّ).
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mihrab-web

[Install]
WantedBy=multi-user.target
