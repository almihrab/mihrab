@@ -17,6 +18,12 @@ registerSingleton(ITerminalProfileResolverService, BrowserTerminalProfileResolve
 KeybindingsRegistry.registerKeybindingRule({
 	id: TerminalCommandId.New,
 	weight: KeybindingWeight.WorkbenchContrib,
-	when: TerminalContextKeys.notFocus,
+	// `notFocus` alone is not enough: this rule is registered on the keybinding registry
+	// directly, so it bypasses the `precondition` that gates the action everywhere else. In a
+	// web workbench with no remote connection the chord therefore reached a command that
+	// cannot run, which is worse than the external terminal it stands in for — that one at
+	// least does nothing visible. `webExtensionContributedProfile` keeps the chord working
+	// when an extension makes terminals possible without a remote.
+	when: ContextKeyExpr.and(TerminalContextKeys.notFocus, ContextKeyExpr.or(TerminalContextKeys.processSupported, TerminalContextKeys.webExtensionContributedProfile)),
 	primary: KeyMod.CtrlCmd | KeyMod.Shift | KeyCode.KeyC
 });
