+/**
+ * The direction the first strong character of `value` is written in, or `undefined` when it holds no
+ * strong character at all — digits, punctuation and whitespace say nothing about direction, and
+ * neither does an empty field. Mirrors what the bidi algorithm does to pick a paragraph direction.
+ */
+function firstStrongCharacterDirection(value: string): 'rtl' | 'ltr' | undefined {
+	for (const character of value) {
+		if (strings.containsRTL(character)) {
+			return 'rtl';
+		}
+		if (STRONG_LTR_CHARACTER.test(character)) {
+			return 'ltr';
+		}
+	}
+	return undefined;
+}
+
+/**
+ * A letter, in any script and on any plane, plus the left-to-right mark. Every letter is strongly
+ * directional, and the right-to-left ones have already been claimed by `containsRTL` by the time this
+ * is reached, so what is left is written left to right. Digits and punctuation are deliberately not
+ * here: they take their direction from their surroundings rather than giving it.
+ *
+ * The `u` flag matters — without it the pattern matches half of a surrogate pair, and text in the
+ * supplementary planes (Mathematical Alphanumerics, Deseret, Osage) would read as having no strong
+ * character at all.
+ */
+const STRONG_LTR_CHARACTER = /[\p{L}\p{Nl}‎]/u;
